# Documentation only: run.py does not automatically load .env files.
# Prefer explicit run.py command-line options.
M7G_DATA_DIR=./dataset
M7G_OUTPUT_DIR=./results
# Optional local DNABERT-2 snapshot; leave unset to use the upstream repository.
# DNABERT_LOCAL_DIR=./pretrained_models/DNABERT-2-117M
# Optional remote model revision (ideally the original experiment commit SHA).
# M7G_DNABERT_REVISION=COMMIT_SHA_TO_BE_CONFIRMED
# Optional endpoint: no mirror is forced by the release.
# HF_ENDPOINT=https://huggingface.co
